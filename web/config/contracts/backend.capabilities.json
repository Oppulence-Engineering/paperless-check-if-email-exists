{
	"schemaVersion": 1,
	"service": {
		"name": "check-if-email-exists",
		"apiVersion": "4.3.0"
	},
	"auth": {
		"audience": "check-if-email-exists-api"
	},
	"http": {
		"basePath": "/v1",
		"openapiPath": "config/contracts/backend.openapi.json",
		"requestTimeoutMs": 15000,
		"maxRequestBodyBytes": 10485760
	},
	"transports": {
		"rest": {
			"enabled": true
		},
		"sse": {
			"enabled": false
		},
		"websocket": {
			"enabled": false,
			"connectionPath": null
		}
	},
	"uploads": {
		"enabled": false,
		"descriptorPath": null,
		"maxBytes": 10485760,
		"allowedContentTypes": []
	},
	"health": {
		"livenessPath": "/healthz",
		"readinessPath": "/readyz",
		"timeoutMs": 2000
	},
	"pagination": {
		"strategy": "offset",
		"defaultPageSize": 50,
		"maxPageSize": 200
	},
	"contract": {
		"errorMediaType": "application/json",
		"requiredOperationIds": ["v1_check_email", "v1_me", "v1_list_lists"]
	},
	"features": {}
}
