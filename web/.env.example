# Check If Email Exists web app. `make dev` at the repository root supplies
# these local defaults; copy this file to .env.local for standalone web work.

# Required in production.
BETTER_AUTH_URL=http://localhost:3000
# Generate separate values of at least 32 characters for production.
BETTER_AUTH_SECRET=
SCIM_CREDENTIAL_HASH_SECRET=
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:25432/reacher
# Optional elevated connection used only by auth:migrate and auth:import-workos.
# AUTH_MIGRATION_DATABASE_URL=
BACKEND_API_URL=http://127.0.0.1:8081
BACKEND_JWT_AUDIENCE=check-if-email-exists-api
BACKEND_OPENAPI_PATH=config/contracts/backend.openapi.json
# Optional deployment-specific capability manifest. Defaults to the repository contract.
# BACKEND_CAPABILITIES_PATH=config/contracts/backend.capabilities.json

# Optional realtime/WebSocket integration. The backend path receives the same
# short-lived audience-bound JWT as other server-to-backend calls and returns a
# browser-safe, single-use WebSocket descriptor. Comma-separate socket origins.
# REALTIME_BACKEND_CONNECTION_PATH=/realtime/connection
# REALTIME_ALLOWED_ORIGINS=ws://localhost:18083
# REALTIME_HANDSHAKE_TIMEOUT_MS=10000
RESEND_API_KEY=
RESEND_FROM=Check If Email Exists <noreply@example.com>

# open, invite-only, or disabled.
REGISTRATION_MODE=open
TRUSTED_PUBLIC_ORIGINS=http://localhost:3000

# Optional OAuth providers. Set the enable flag to 0 to force-disable.
# AUTH_GOOGLE_ENABLED=1
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AUTH_MICROSOFT_ENABLED=1
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# Optional external API documentation redirect.
# BACKEND_DOCS_URL=https://api.example.com/docs

# Optional deployment branding. Asset URLs must be same-origin paths or HTTPS.
# BRAND_NAME=Check If Email Exists
# BRAND_LOGO_URL=/marketing/oppulence-icon.png
# BRAND_WORDMARK_URL=
# BRAND_FAVICON_URL=/marketing/oppulence-icon.png
# BRAND_PRIMARY_COLOR=#111111
# BRAND_ACCENT_COLOR=#F97316
# BRAND_SUPPORT_EMAIL=support@example.com
# BRAND_DOCUMENTATION_URL=https://docs.example.com
# BRAND_TERMS_URL=/terms
# BRAND_PRIVACY_URL=/privacy

# Optional public metadata.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Local sign-in fixture; only use on loopback with local PostgreSQL.
# AUTH_E2E_MODE=1
# AUTH_E2E_OTP=123456

# Platform support access. Comma-separated emails allowed to open /app/admin and
# see every workspace on this deployment. Empty means nobody, which is the default.
# PLATFORM_ADMIN_EMAILS=

# Log level for the structured logger: debug, info, warn or error.
# Defaults to info in production and debug everywhere else.
# LOG_LEVEL=info
