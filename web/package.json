	"name": "check-if-email-exists-web",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@9.15.4",
	"scripts": {
		"dev": "next dev",
		"build": "node scripts/build.mjs",
		"start": "node scripts/start-standalone.mjs",
		"analyze": "next experimental-analyze --output",
		"arch": "depcruise app components hooks lib vendor/oppulence/ui/src --config config/architecture/dependency-cruiser.config.mjs --output-type err-long",
		"bundle:check": "node scripts/check-bundle-budget.mjs",
		"gen": "tsx scripts/generate.ts",
		"gen:check": "vitest run quality/generate-policies.test.ts quality/generate-drift.test.ts quality/generate-kinds.test.ts quality/generate-orval.test.ts quality/generate-component.test.ts",
		"component:new": "tsx scripts/generate.ts component",
		"contracts:check": "node scripts/check-generated-contracts.mjs",
		"contracts:compatibility": "tsx scripts/check-backend-compatibility.ts",
		"queries:check": "node scripts/check-react-query-patterns.mjs && node scripts/check-client-boundary-imports.mjs",
		"contracts:generate": "orval --config config/contracts/orval.config.ts",
		"auth:schema:generate": "auth generate --config config/auth/better-auth.cli.ts --output config/auth/better-auth.generated.sql --yes",
		"auth:migrate": "node scripts/migrate-auth.mjs",
		"auth:drift:check": "node scripts/check-auth-schema.mjs",
		"format": "prettier --config config/quality/prettier.json --write .",
		"format:check": "prettier --config config/quality/prettier.json --check .",
		"knip": "knip --config config/quality/knip.json",
		"lighthouse": "node scripts/run-lighthouse.mjs",
		"lint": "eslint .",
		"security:gitleaks": "node scripts/run-gitleaks.mjs",
		"security:osv": "go run github.com/google/osv-scanner/v2/cmd/osv-scanner@v2.5.1 scan source --config=config/quality/osv-scanner.toml .",
		"security:semgrep": "pipx run --spec semgrep==1.174.0 semgrep scan --config config/quality/semgrep.yml --error --metrics=off --no-git-ignore --exclude=node_modules --exclude=.next --exclude='lib/api/generated/**' --exclude='.check-email-contracts-*' .",
		"test": "vitest run",
		"test:a11y": "playwright test --grep @a11y",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:smoke": "playwright test --grep @smoke",
		"storybook": "storybook dev -p 6006",
		"storybook:build": "storybook build",
		"test:watch": "vitest",
		"typecheck": "tsgo --noEmit",
		"shadcn": "shadcn",
		"ui:add": "node scripts/add-ui-component.mjs",
		"ui:info": "shadcn info && shadcn info --cwd vendor/oppulence/ui",
		"ui:init": "node scripts/shadcn-init.mjs",
		"verify": "node scripts/run-verify.mjs default",
		"verify:ci": "node scripts/run-verify.mjs ci",
		"verify:fast": "node scripts/run-verify.mjs fast",
		"dev:local": "bash ../scripts/dev.sh",
		"dev:stack": "bash ../scripts/dev.sh",
		"dev:contracts": "bash scripts/dev-contracts.sh",
		"dev:doctor": "pnpm dlx react-doctor@latest .",
		"postinstall": "fumadocs-mdx config/fumadocs/source.config.ts"
	},
