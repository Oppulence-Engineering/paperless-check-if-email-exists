# Copy this file to .env
# ```bash
# cp .env.example .env
# ```
#
# Then tweak the values to match your desired config.

RUST_LOG=reacher=info
SQLX_OFFLINE=true
RCH_WEBDRIVER_ADDR=http://localhost:9515

# `make dev` starts PostgreSQL, RabbitMQ, the Rust API, and Next.js.
# These defaults are local only; override them for other environments.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:25432/reacher
BETTER_AUTH_URL=http://localhost:3000
BACKEND_API_URL=http://127.0.0.1:8081
BACKEND_JWT_AUDIENCE=check-if-email-exists-api
TRUSTED_PUBLIC_ORIGINS=http://localhost:3000
REGISTRATION_MODE=open
# Generate separate random values for production.
BETTER_AUTH_SECRET=local-better-auth-secret-for-development-only
SCIM_CREDENTIAL_HASH_SECRET=local-scim-secret-for-development-only
RCH__HEADER_SECRET=local-backend-secret-for-development-only
RCH__AUTH__JWKS_URL=http://127.0.0.1:3000/api/auth/jwks
RCH__AUTH__ISSUER=http://localhost:3000
RCH__AUTH__AUDIENCE=check-if-email-exists-api
# Local only. Never enable fixed OTPs on a public deployment.
AUTH_E2E_MODE=1
AUTH_E2E_OTP=123456

# ------------------------------------------------------------------------------
# Proxy Configuration (Oxylabs Residential Proxies)
# ------------------------------------------------------------------------------
# See docs/self-hosting/proxies/README.md for detailed proxy settings.
# Requires SOCKS5 proxy support for SMTP connections.

# Default proxy (routed via SOCKS5)
# RCH__PROXY__HOST=pr.oxylabs.io
# RCH__PROXY__PORT=7777
# RCH__PROXY__USERNAME=customer-<YOUR_USERNAME>-sessid-<SESSION_ID>-sesstime-<MINUTES>
# RCH__PROXY__PASSWORD=<YOUR_PASSWORD>

# Helper fields for SMTP HELO/MAIL FROM.
# Ideally these match the RDNS of the proxy IP.
# RCH__HELLO_NAME=reacher.email
# RCH__FROM_EMAIL=hello@reacher.email
